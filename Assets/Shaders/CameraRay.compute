// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CameraRayCS

struct Ray {
    float3 position;
    float3 direction;
};

RWTexture2D<float4> Position;
RWTexture2D<float4> Direction;
RWTexture2D<float4> Throughput;
RWTexture2D<float4> Result;
RWTexture2D<float> IsComplete;
RWTexture2D<float> DT;

TextureCube _skybox;
SamplerState sampler_skybox;

float4x4 inverseProjectionMatrix;
float4x4 cameraToWorldMatrix;
int numSamples;
int width;
int height;
int mass;
float maxTimeIncrement;

float4 toSphericalCoords(float4 cart){
    float r = length(cart.xyz);
    float theta = atan2(r, cart.y);
    float phi = atan2(cart.z, cart.x);

    return float4(r, theta, phi, cart.w);
}

float3 toSphericalVector(float4 origin, float3 vec){
    float r = length(origin.xyz);
    float rxz = length(origin.xz);
    float x = origin.x;
    float y = origin.y;
    float z = origin.z;
    
    float3x3 Jacobian = {
        x / r,
        y / r,
        z / r,
        (x * y) / (r * r * rxz),
        -1.0 * rxz / (r * r), 
        z * y / (r * rxz),
        -z / rxz,
        0.0,
        x / rxz
    };

    return mul(Jacobian, vec);
}


// PCG (permuted congruential generator). Thanks to:
// www.pcg-random.org and www.shadertoy.com/view/XlGcRh
float NextRandom(inout uint state)
{
    state = state * 747796405 + 2891336453;
    uint result = ((state >> ((state >> 28) + 4)) ^ state) * 277803737;
    result = (result >> 22) ^ result;
    return result;
}

float RandomValue(inout uint state){
    return NextRandom(state) / 4294967295.0 * 2.0 - 1.0; // 2^32 - 1;
}

float2 RandomValueInCircle(inout uint state) 
{
    while(true){
        float2 pt = float2(RandomValue(state), RandomValue(state));
        if(length(pt) <= 1) {
            return pt;
        }
    }

    return float2(0.0, 0.0);
}

Ray createRay(float3 origin, float3 direction) {
    Ray ray;
    ray.position = origin;
    ray.direction = direction;

    return ray;
}

Ray cameraRay(float2 uv, float2 jitter, inout uint state) {
    float2 jitterOrigin = float2(RandomValue(state), RandomValue(state)) * jitter;
    float3 origin = mul(cameraToWorldMatrix, float4(jitterOrigin.x, jitterOrigin.y, 0.0, 1.0)).xyz;
    float4 dir = mul(inverseProjectionMatrix, float4(uv, 0.0, 1.0));
    dir /= dir.w;
    dir = mul(cameraToWorldMatrix, dir);

    // float d = abs(dir.z);
    // float dp = length(dir.xyz);

    // float3 focusPoint = dp / d * (d + focusDistance) * normalize(dir.xyz); 
    // focusPoint = float3(focusPoint.x + jitterDir.x, focusPoint.y + jitterDir.y, focusPoint.z);
    // focusPoint = mul(cameraToWorldMatrix, float4(focusPoint.x, focusPoint.y, focusPoint.z, 1.0)).xyz;

    // origin = mul(cameraToWorldMatrix, float4(dir.x + , dir.y + , dir.z, 1.0)).xyz;

    return createRay(origin, normalize(dir.xyz - origin));
    // return createRay(origin, normalize(focusPoint - origin));
}

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture

[numthreads(8,8,1)]
void CameraRayCS (uint3 id : SV_DispatchThreadID)
{
    // TODO: insert actual code here!

    float2 uv = id.xy / float2(width, height) * 2 - 1.0;
    uint state = id.x + id.y * width;

    uint2 index = uint2(id.x * numSamples, id.y * numSamples);
    Ray r = cameraRay(uv, float2(1.0/float(width), 1.0/float(height)), state);

    // float4 origin = toSphericalCoords(float4(r.position.x, r.position.y, r.position.z, 0.0));
    float4 cameraPos = mul(cameraToWorldMatrix, float4(0.0, 0.0, 0.0, 1.0));
    // float3 direction = toSphericalVector(cameraPos, float3(r.direction.x, r.direction.y, r.direction.z));

    float3 direction = float3(r.direction.x, r.direction.y, r.direction.z);

    float rs = 2 * mass;

    // direction.x *= (1.0 - (mass / origin.x));
    // direction.y *= origin.x * origin.x;
    // direction.z *= origin.x * sin(origin.y);

    Position[index] = float4(cameraPos.x, cameraPos.y, cameraPos.z, 0.0);
    Direction[index] = float4(direction.x, direction.y, direction.z, 0.0);
    Throughput[index] = float4(1.0, 1.0, 1.0, 1.0);
    Result[index] = float4(0.0, 0.0, 0.0, 1.0);
    IsComplete[index] = 0.0;
    DT[index] = maxTimeIncrement;
}
