// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel TraceRayCS

#include "sdfs.cginc"
#include "blackhole.cginc"

static const float DIST_EPSILON = 0.01f;
static const float EPSILON = 1.0f;
static const uint MAX_ITERATIONS = 100;
static const float MAX_DIST = 200.0f;


// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2D<float> IsComplete;
RWTexture2D<float4> Position;
RWTexture2D<float4> Direction;
RWTexture2D<float> DT;
RWTexture2D<float4> Result;
RWTexture2D<float4> Throughput;

TextureCube _skybox;
SamplerState sampler_skybox;

StructuredBuffer<Sphere> spheres;
StructuredBuffer<Box> boxes;

int mass;
int numSpheres;
int numBoxes;
int width;
bool hardStop;

float3 toCartesianCoordinates(float3 spherical){
    float r = spherical.x;
    float theta = spherical.y;
    float phi = spherical.z;

    return float3(
        r * sin(theta) * cos(phi),
        r * cos(phi),
        r * sin(theta) * sin(theta)
    );
}

float NextRandom(inout uint state)
{
    state = state * 747796405 + 2891336453;
    uint result = ((state >> ((state >> 28) + 4)) ^ state) * 277803737;
    result = (result >> 22) ^ result;
    return result;
}

float RandomValue(inout uint state){
    return NextRandom(state) / 4294967295.0 * 2.0 - 1.0; // 2^32 - 1;
}

float3 getRandomHemisphereVector(inout uint state, float3 normal) {
    uint count = 0;
    
    while(true){
        float3 vec = float3(
            RandomValue(state),
            RandomValue(state),
            RandomValue(state)
        );
        
        if(length(vec) <= 1){
            float d = dot(normal, vec);
            
            if(d >= 0){
                return normalize(vec);
            } else {
                return normalize(-vec);
            }
        }

        count++;
    }

    return normal;
}

