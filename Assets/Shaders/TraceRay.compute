[numthreads(8,8,1)]
void TraceRayCS (uint3 id : SV_DispatchThreadID)
{
    uint state = id.x + id.y * width;
    float isComplete = IsComplete[id.xy];

    if(isComplete <= 0.0){
        // Result[id.xy] = float4(1.0, 0.0, 0.0, 0.0);
        float4 position = Position[id.xy];
        float3 direction = Direction[id.xy].xyz;
        float3 pixelLight = Result[id.xy].xyz;
        float3 rayColor = Throughput[id.xy].xyz;
        float dt = DT[id.xy];
        
        float t = position.w;

        float3 x = float3(position.x, position.y, position.z);
        float3 oldDir = float3(direction.x, direction.y, direction.z);
        rungeKuttaIntegration(mass, dt, 4, position, direction);

        if(hardStop){
            pixelLight = float3(1.0, 0.0, 0.0);
        } else {
            bool shortenDT = false;

            float3 cart = float3(position.x, position.y, position.z);

            if(sphereSDF(cart, float3(0.0, 0.0, 0.0), 2.0 * mass) < EPSILON){
                pixelLight = 1.0;
                isComplete = 0.0;
            }
            else{
                for(int j = 1; j < numSpheres + 1; j++){
                    float3 normal = getSphereNormal(position, spheres[j].position, spheres[j].radius);
                    float dist = sphereSDF(position, spheres[j].position, spheres[j].radius);
                        
                    if(abs(dist) < EPSILON){
                        Material material = spheres[j].material;

                        float3 emittedColor = material.emissionColor.xyz * material.emissionStrength;
                    
                        pixelLight += emittedColor.xyz * rayColor;

                        if(material.emissionStrength > 0.5) {
                            position += float4(normal.x, normal.y, normal.z, 0.0) * DIST_EPSILON;
                            isComplete = 1.0;
                        }
                        else{
                            rayColor *= false ? material.specularColor.xyz : material.color.xyz;
                            float3 diffuseDirection = normalize(normal + getRandomHemisphereVector(state, normal)); // diffuse direction
                            position += float4(normal.x, normal.y, normal.z, 0.0) * DIST_EPSILON;
                            direction = diffuseDirection;
                            isComplete = 0.0;
                        }
                    }
                    else if(dist < 0.0){
                        shortenDT = true;
                    }
                }

                if(shortenDT){
                    DT[id.xy] = dt * 0.5;
                    position = float4(x.x, x.y, x.z, t);
                    direction = oldDir;
                }
            }
        }

        Position[id.xy] = position;
        Direction[id.xy] = float4(direction.x, direction.y, direction.z, 0.0);
        Result[id.xy] = float4(pixelLight.x, pixelLight.y, pixelLight.z, 0.0);
        Throughput[id.xy] = float4(rayColor.x, rayColor.y, rayColor.z, 1.0);
        IsComplete[id.xy] = isComplete;
    }
}

