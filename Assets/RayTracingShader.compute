[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    uint width, height;

    Result.GetDimensions(width, height);

    float2 uv = id.xy / float2(width, height) * 2 - 1.0;

    int n = 50;
    float3 col = float3(0.0f, 0.0f, 0.0f);
    uint seed = id.x + id.y * width;
    for(int i = 0; i < n; i++) {
        col += traceRay(cameraRay(uv, defocusStrength, float2(1.0/float(width), 1.0/float(height)), seed), seed);
    }
    
    col /= n;

    Result[id.xy] = float4(col.x, col.y, col.z, 1.0);

    // Ray r = {
    //     float3(0.0, 0.0, 0.0),
    //     float3(321.0, 31.0, 20.0)
    // };

    // changeRay(r);

    // bool changed = length(r.position) > 1.0;
    
    // Result[id.xy] = changed ? float4(1.0, 1.0, 1.0, 1.0) : float4(0.0, 0.0, 0.0, 1.0);
}
